{
  "description": "Report the state of the Veilwrack save at session start. Never imports, never blocks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 120000,
            "statusMessage": "Checking the Veilwrack save file",
            "async": false
          }
        ]
      }
    ]
  }
}
